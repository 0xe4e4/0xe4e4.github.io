---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const base = import.meta.env.BASE_URL;
const root = base.endsWith('/') ? base : `${base}/`;
const homeHref = root;
const blogHref = `${root}#blog`;
const aboutHref = `${root}#about`;
---

<header>
	<nav>
		<h2><a href={homeHref}>{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href={homeHref} route="home">Home</HeaderLink>
			<HeaderLink href={blogHref} route="blog">記事一覧</HeaderLink>
			<HeaderLink href={aboutHref} route="about">About</HeaderLink>
		</div>
	</nav>
</header>
<script is:inline>
	(function () {
		function stripBasePath(pathname) {
			var raw = document.documentElement.getAttribute('data-base') || '/';
			var b = raw.replace(/\/$/, '') || '';
			if (!b || b === '/') return pathname;
			if (pathname.startsWith(b)) {
				var rest = pathname.slice(b.length);
				return rest.startsWith('/') ? rest : '/' + rest;
			}
			return pathname;
		}

		function syncNav() {
			var path = stripBasePath(location.pathname);
			if (!path.startsWith('/')) path = '/' + path;
			var hash = (location.hash || '').replace(/^#\/?/, '');
			var parts = path
				.replace(/^\/+|\/+$/g, '')
				.split('/')
				.filter(Boolean);
			var isBlogPost = parts[0] === 'blog' && parts.length >= 2;

			document
				.querySelectorAll('header nav a[data-route]')
				.forEach(function (a) {
					var route = a.getAttribute('data-route');
					var active = false;
					if (route === 'home') active = (path === '/' || path === '') && !hash;
					else if (route === 'blog') active = hash === 'blog' || isBlogPost;
					else if (route === 'about') active = hash === 'about';
					a.classList.toggle('active', active);
				});
		}

		document.addEventListener('DOMContentLoaded', syncNav);
		window.addEventListener('hashchange', syncNav);
	})();
</script>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: rgba(15, 23, 42, 0.92);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(148, 163, 184, 0.14);
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: rgb(var(--black));
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--gray-dark));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	nav a:hover {
		color: rgb(var(--black));
	}
</style>
