---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & { route?: 'home' | 'blog' | 'about' };

const { href, class: className, route, ...props } = Astro.props;
---

<a
	href={href}
	class:list={[className]}
	data-route={route ?? undefined}
	{...props}
>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
