---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
	{
		posts.map((post) => (
			<li>
				<a href={`/blog/${post.id}/`}>
					{post.data.heroImage && (
						<div class="thumb">
							<Image
								width={720}
								height={360}
								src={post.data.heroImage}
								alt=""
							/>
						</div>
					)}
					<div class="post-row">
						<h3 class="post-title">{post.data.title}</h3>
						<p class="post-date">
							<FormattedDate date={post.data.date} />
						</p>
					</div>
				</a>
			</li>
		))
	}
</ul>

<style is:global>
	.post-list {
		list-style: none;
		margin: 2em 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}
	.post-list li a {
		display: block;
		text-decoration: none;
		color: inherit;
		padding: 0.25em 0;
		border-bottom: 1px solid rgba(var(--gray), 0.2);
	}
	.post-list li a:hover .post-title {
		color: var(--accent);
	}
	.post-row {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	@media (min-width: 600px) {
		.post-row {
			flex-direction: row;
			align-items: baseline;
			justify-content: space-between;
			gap: 1.5rem;
		}
	}
	.post-title {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 600;
		line-height: 1.35;
		transition: color 0.15s ease;
	}
	.post-date {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.95rem;
		flex-shrink: 0;
	}
	.thumb {
		margin: 0 0 0.75rem 0;
		border-radius: 8px;
		overflow: hidden;
	}
	.thumb img {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
