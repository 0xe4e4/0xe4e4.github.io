---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import PostList from '../components/PostList.astro';
import SiteShell from '../components/SiteShell.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { sortBlogPostsNewestFirst } from '../utils/sortBlogPosts';

const allPosts = sortBlogPostsNewestFirst(await getCollection('blog'));
---

<SiteShell title={SITE_TITLE} description={SITE_DESCRIPTION} posts={allPosts}>
	<style is:global slot="head">
		.spa-view[hidden] {
			display: none !important;
		}
		.about-hero {
			width: 100%;
			max-width: 68ch;
			margin: 0 0 1.25rem 0;
		}
		.about-hero img {
			display: block;
			margin: 0 auto;
			border-radius: 8px;
			box-shadow: var(--box-shadow);
		}
		.about-prose {
			max-width: 68ch;
		}
		.home-intro {
			max-width: 68ch;
			margin-bottom: 2.75rem;
		}
		.home-intro__header {
			margin: 0 0 1.35rem 0;
			padding-bottom: 1rem;
			border-bottom: 1px solid rgba(148, 163, 184, 0.28);
		}
		.home-intro__header h1 {
			margin: 0 0 0.35rem 0;
			font-size: clamp(1.9rem, 4.2vw, 2.4rem);
			letter-spacing: -0.03em;
			line-height: 1.2;
		}
		.home-intro__tag {
			display: block;
			margin: 0 0 0.5rem 0;
			font-size: 0.75rem;
			font-weight: 600;
			letter-spacing: 0.08em;
			color: rgb(var(--gray));
		}
		.home-intro__lead {
			margin: 0 0 1.75rem 0;
			font-size: clamp(1.12rem, 2.2vw, 1.22rem);
			line-height: 1.72;
			color: rgb(var(--gray-dark));
			letter-spacing: 0.01em;
		}
		.home-intro__note {
			margin: 0;
			padding: 1rem 1.1rem 1.05rem 1.15rem;
			border-left: 3px solid var(--accent);
			border-radius: 0 8px 8px 0;
			background: rgba(148, 163, 184, 0.08);
			font-size: 0.94rem;
			line-height: 1.68;
			color: rgb(var(--gray-dark));
		}
		.home-intro__note p {
			margin: 0 0 0.65rem 0;
		}
		.home-intro__note p:last-child {
			margin-bottom: 0;
		}
		.blog-list-section {
			max-width: 68ch;
		}
		.blog-list-section > h2 {
			margin-top: 0;
			margin-bottom: 0.35rem;
		}
	</style>

	<div class="spa-view" data-spa-view="main">
		<div class="home-intro">
			<header class="home-intro__header">
				<span class="home-intro__tag">このサイト</span>
				<h1>{SITE_TITLE}</h1>
			</header>
			<p class="home-intro__lead">{SITE_DESCRIPTION}</p>
			<aside class="home-intro__note" aria-label="このページについて">
				<p>右のリストは直近の記事です。下はすべての記事です。</p>
				<p>RSS はページ上部のリンクから購読できます。</p>
			</aside>
		</div>

		<section id="blog" class="blog-list-section" aria-labelledby="blog-heading">
			<h2 id="blog-heading">記事一覧</h2>
			<PostList posts={allPosts} />
		</section>
	</div>

	<div class="spa-view" data-spa-view="about" hidden>
		<div class="about-hero">
			<Image width={1020} height={510} src={AboutHeroImage} alt="" />
		</div>
		<div class="about-prose">
			<h1>About</h1>
			<p>
				ローカルの Obsidian で書いた Markdown を GitHub に push
				するだけで公開される、個人用の日記サイトです。コメント・いいね・通知はありません。
			</p>
		</div>
	</div>

	<script is:inline>
		(function () {
			function applyView() {
				var h = (location.hash || '').replace(/^#\/?/, '');
				var v = h === 'about' ? 'about' : 'main';
				document.querySelectorAll('[data-spa-view]').forEach(function (el) {
					var on = el.getAttribute('data-spa-view') === v;
					if (on) el.removeAttribute('hidden');
					else el.setAttribute('hidden', '');
				});
			}

			function scrollToBlogIfNeeded() {
				var h = (location.hash || '').replace(/^#\/?/, '');
				if (h !== 'blog') return;
				var el = document.getElementById('blog');
				if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}

			function onRoute() {
				applyView();
				requestAnimationFrame(function () {
					scrollToBlogIfNeeded();
				});
			}

			document.addEventListener('DOMContentLoaded', onRoute);
			window.addEventListener('hashchange', onRoute);
		})();
	</script>
</SiteShell>
