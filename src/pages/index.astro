---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import PostList from '../components/PostList.astro';
import SiteShell from '../components/SiteShell.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { sortBlogPostsNewestFirst } from '../utils/sortBlogPosts';

const allPosts = sortBlogPostsNewestFirst(await getCollection('blog'));
---

<SiteShell title={SITE_TITLE} description={SITE_DESCRIPTION} posts={allPosts}>
	<style is:global slot="head">
		.spa-view[hidden] {
			display: none !important;
		}
		.about-hero {
			width: 100%;
			max-width: 68ch;
			margin: 0 0 1.25rem 0;
		}
		.about-hero img {
			display: block;
			margin: 0 auto;
			border-radius: 8px;
			box-shadow: var(--box-shadow);
		}
		.about-prose {
			max-width: 68ch;
		}
		.home-intro {
			max-width: 68ch;
		}
	</style>

	<div class="spa-view" data-spa-view="main">
		<div class="home-intro">
			<h1>{SITE_TITLE}</h1>
			<p>{SITE_DESCRIPTION}</p>
			<p>
				右のリストは直近の記事です。下はすべての記事です。RSS
				はページ上部のリンクから購読できます。
			</p>
		</div>

		<section id="blog" class="blog-list-section" aria-labelledby="blog-heading">
			<h2 id="blog-heading">記事一覧</h2>
			<PostList posts={allPosts} />
		</section>
	</div>

	<div class="spa-view" data-spa-view="about" hidden>
		<div class="about-hero">
			<Image width={1020} height={510} src={AboutHeroImage} alt="" />
		</div>
		<div class="about-prose">
			<h1>About</h1>
			<p>
				ローカルの Obsidian で書いた Markdown を GitHub に push
				するだけで公開される、個人用の日記サイトです。コメント・いいね・通知はありません。
			</p>
		</div>
	</div>

	<script is:inline>
		(function () {
			function applyView() {
				var h = (location.hash || '').replace(/^#\/?/, '');
				var v = h === 'about' ? 'about' : 'main';
				document.querySelectorAll('[data-spa-view]').forEach(function (el) {
					var on = el.getAttribute('data-spa-view') === v;
					if (on) el.removeAttribute('hidden');
					else el.setAttribute('hidden', '');
				});
			}

			function scrollToBlogIfNeeded() {
				var h = (location.hash || '').replace(/^#\/?/, '');
				if (h !== 'blog') return;
				var el = document.getElementById('blog');
				if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}

			function onRoute() {
				applyView();
				requestAnimationFrame(function () {
					scrollToBlogIfNeeded();
				});
			}

			document.addEventListener('DOMContentLoaded', onRoute);
			window.addEventListener('hashchange', onRoute);
		})();
	</script>
</SiteShell>
