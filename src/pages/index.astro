---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import FormattedDate from '../components/FormattedDate.astro';
import SiteShell from '../components/SiteShell.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { sortBlogPostsNewestFirst } from '../utils/sortBlogPosts';

const allPosts = sortBlogPostsNewestFirst(await getCollection('blog'));

const base = import.meta.env.BASE_URL;
const root = base.endsWith('/') ? base : `${base}/`;
const blogHashUrl = `${root}#blog`;
---

<SiteShell title={SITE_TITLE} description={SITE_DESCRIPTION} posts={allPosts}>
	<style is:global slot="head">
		.spa-view[hidden] {
			display: none !important;
		}
		.post-list {
			list-style: none;
			margin: 2em 0 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: 1.75rem;
		}
		.post-list li a {
			display: block;
			text-decoration: none;
			color: inherit;
			padding: 0.25em 0;
			border-bottom: 1px solid rgba(var(--gray), 0.2);
		}
		.post-list li a:hover .post-title {
			color: var(--accent);
		}
		.post-row {
			display: flex;
			flex-direction: column;
			gap: 0.35rem;
		}
		@media (min-width: 600px) {
			.post-row {
				flex-direction: row;
				align-items: baseline;
				justify-content: space-between;
				gap: 1.5rem;
			}
		}
		.post-title {
			margin: 0;
			font-size: 1.2rem;
			font-weight: 600;
			line-height: 1.35;
			transition: color 0.15s ease;
		}
		.post-date {
			margin: 0;
			color: rgb(var(--gray));
			font-size: 0.95rem;
			flex-shrink: 0;
		}
		.thumb {
			margin: 0 0 0.75rem 0;
			border-radius: 8px;
			overflow: hidden;
		}
		.thumb img {
			display: block;
			width: 100%;
			height: auto;
		}
		.about-hero {
			width: 100%;
			max-width: 68ch;
			margin: 0 0 1.25rem 0;
		}
		.about-hero img {
			display: block;
			margin: 0 auto;
			border-radius: 8px;
			box-shadow: var(--box-shadow);
		}
		.about-prose {
			max-width: 68ch;
		}
	</style>

	<div class="spa-view" data-spa-view="home">
		<h1>{SITE_TITLE}</h1>
		<p>{SITE_DESCRIPTION}</p>
		<p>
			右のリストは直近の記事です。すべての記事は
			<a href={blogHashUrl}>記事一覧</a>
			から。RSS はページ上部のリンクから購読できます。
		</p>
	</div>

	<div class="spa-view" data-spa-view="blog" hidden>
		<h1>記事一覧</h1>
		<ul class="post-list">
			{
				allPosts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							{post.data.heroImage && (
								<div class="thumb">
									<Image width={720} height={360} src={post.data.heroImage} alt="" />
								</div>
							)}
							<div class="post-row">
								<h2 class="post-title">{post.data.title}</h2>
								<p class="post-date">
									<FormattedDate date={post.data.date} />
								</p>
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</div>

	<div class="spa-view" data-spa-view="about" hidden>
		<div class="about-hero">
			<Image width={1020} height={510} src={AboutHeroImage} alt="" />
		</div>
		<div class="about-prose">
			<h1>About</h1>
			<p>
				ローカルの Obsidian で書いた Markdown を GitHub に push するだけで公開される、個人用の日記サイトです。コメント・いいね・通知はありません。
			</p>
		</div>
	</div>

	<script is:inline>
		(function () {
			function applyView() {
				var h = (location.hash || '').replace(/^#\/?/, '');
				var v = h === 'blog' ? 'blog' : h === 'about' ? 'about' : 'home';
				document.querySelectorAll('[data-spa-view]').forEach(function (el) {
					var on = el.getAttribute('data-spa-view') === v;
					if (on) el.removeAttribute('hidden');
					else el.setAttribute('hidden', '');
				});
			}
			document.addEventListener('DOMContentLoaded', applyView);
			window.addEventListener('hashchange', applyView);
		})();
	</script>
</SiteShell>
