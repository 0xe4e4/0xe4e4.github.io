---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import type { RentalListing, RentalsSnapshot } from '../../data/rentals.types';
import rentalsJson from '../../data/rentals.json';

const data = rentalsJson as RentalsSnapshot;
const title = `通勤圏の賃貸空室 | ${SITE_TITLE}`;
const description =
	'船橋市西浦付近への車通勤圏・駅徒歩15分以内・1DK〜3LDK・家賃10万以下・洗面独立・駐車場ありの賃貸スナップショット。';

const updatedLabel = data.updatedAt
	? new Date(data.updatedAt).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' })
	: '未更新';

const bySource = {
	suumo: data.listings.filter((l) => l.source === 'suumo').length,
	yahoo: data.listings.filter((l) => l.source === 'yahoo').length,
	athome: data.listings.filter((l) => l.source === 'athome').length,
};

function sourceLabel(source: string) {
	if (source === 'suumo') return 'SUUMO';
	if (source === 'yahoo') return 'Yahoo';
	if (source === 'athome') return 'アットホーム';
	return source;
}

const listings = [...data.listings].sort((a, b) => {
	const ca = a.carMinutes ?? 999;
	const cb = b.carMinutes ?? 999;
	if (ca !== cb) return ca - cb;
	return (a.rentYen ?? 0) - (b.rentYen ?? 0);
});

interface ListingGroup {
	id: string;
	title: string;
	address: string;
	items: RentalListing[];
}

const listingGroups: ListingGroup[] = [];
const groupMap = new Map<string, ListingGroup>();
for (const item of listings) {
	const key = `${item.title}\t${item.address}`;
	let group = groupMap.get(key);
	if (!group) {
		group = {
			id: `g${listingGroups.length}`,
			title: item.title,
			address: item.address,
			items: [],
		};
		groupMap.set(key, group);
		listingGroups.push(group);
	}
	group.items.push(item);
}

function formatManYen(yen: number) {
	const man = yen / 10000;
	return `${Number.isInteger(man) ? String(man) : man.toFixed(1)}万円`;
}

function rentRangeLabel(items: RentalListing[]) {
	const yens = items
		.map((item) => item.rentYen)
		.filter((n): n is number => n != null);
	if (yens.length === 0) return items[0]?.rentLabel || '—';
	const min = Math.min(...yens);
	const max = Math.max(...yens);
	return min === max
		? formatManYen(min)
		: `${formatManYen(min)}〜${formatManYen(max)}`;
}

function uniqueLabels(
	items: RentalListing[],
	pick: (item: RentalListing) => string,
) {
	return [...new Set(items.map(pick).filter(Boolean))];
}

function jstYmd(iso: string) {
	return new Intl.DateTimeFormat('en-CA', {
		timeZone: 'Asia/Tokyo',
		year: 'numeric',
		month: '2-digit',
		day: '2-digit',
	}).format(new Date(iso));
}

const snapshotDay = data.updatedAt
	? jstYmd(data.updatedAt)
	: jstYmd(new Date().toISOString());

function daysBetween(fromYmd: string, toYmd: string) {
	return Math.round(
		(Date.parse(`${toYmd}T00:00:00+09:00`) -
			Date.parse(`${fromYmd}T00:00:00+09:00`)) /
			86400000,
	);
}

function isWithinTwoDays(iso: string | null | undefined) {
	if (!iso) return false;
	const n = daysBetween(String(iso), snapshotDay);
	return n >= 0 && n <= 2;
}

function isFreshListed(item: RentalListing) {
	return isWithinTwoDays(item.listedAt);
}

function isFreshUpdated(item: RentalListing) {
	return isWithinTwoDays(item.sourceUpdatedAt);
}

function formatMd(iso: string | null | undefined) {
	if (!iso) return '';
	const parts = iso.split('-');
	if (parts.length < 3) return iso;
	return `${Number(parts[1])}/${Number(parts[2])}`;
}

function mapsOrigin(item: Pick<RentalListing, 'address' | 'lat' | 'lon'>) {
	if (item.lat != null && item.lon != null) return `${item.lat},${item.lon}`;
	return item.address.trim();
}

function googleMapsDrivingUrl(
	item: Pick<RentalListing, 'address' | 'lat' | 'lon'>,
) {
	const origin = mapsOrigin(item);
	const destination = data.criteria.destination;
	if (!origin || !destination) return '';
	const params = new URLSearchParams({
		api: '1',
		origin,
		destination,
		travelmode: 'driving',
	});
	return `https://www.google.com/maps/dir/?${params.toString()}`;
}

function newestDate(
	items: RentalListing[],
	field: 'listedAt' | 'sourceUpdatedAt',
) {
	const dates = items.map((item) => item[field]).filter(Boolean) as string[];
	dates.sort();
	return dates.at(-1) || null;
}

const stationOptions = [
	...new Set(listings.map((l) => l.stationName).filter(Boolean)),
].sort((a, b) => a.localeCompare(b, 'ja'));

const STRUCTURE_GROUP_OPTIONS = ['鉄筋系', '鉄骨系', '木造', 'その他'];
const structureDetailOptions = [
	...new Set(listings.map((l) => l.structure).filter(Boolean)),
].sort((a, b) => a.localeCompare(b, 'ja'));
---

<!doctype html>
<html lang="ja" data-base={import.meta.env.BASE_URL}>
	<head>
		<BaseHead title={title} description={description} />
		<meta name="robots" content="noindex, nofollow" />
		<style is:global>
			.rentals-page {
				width: min(1080px, calc(100% - 2em));
				margin: 0 auto;
				padding: 2.5em 1em 4em;
			}
			.rentals-hero {
				margin-bottom: 2rem;
				padding-bottom: 1.25rem;
				border-bottom: 1px solid rgba(148, 163, 184, 0.28);
			}
			.rentals-hero__tag {
				display: block;
				margin: 0 0 0.45rem 0;
				font-size: 0.75rem;
				font-weight: 600;
				letter-spacing: 0.08em;
				color: rgb(var(--gray));
			}
			.rentals-hero h1 {
				margin: 0 0 0.65rem 0;
				font-size: clamp(1.55rem, 3.5vw, 2rem);
				letter-spacing: -0.02em;
			}
			.rentals-hero__lead {
				margin: 0 0 1rem 0;
				font-size: 0.98rem;
				line-height: 1.7;
				color: rgb(var(--gray-dark));
			}
			.rentals-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.55rem 1.1rem;
				margin: 0;
				padding: 0;
				list-style: none;
				font-size: 0.88rem;
				color: rgb(var(--gray));
				align-items: center;
			}
			.rentals-criteria {
				margin: 0 0 2rem 0;
				padding: 1rem 1.15rem;
				border-left: 3px solid var(--accent);
				border-radius: 0 8px 8px 0;
				background: rgba(148, 163, 184, 0.08);
				font-size: 0.92rem;
				line-height: 1.65;
			}
			.rentals-criteria h2 {
				margin: 0 0 0.5rem 0;
				font-size: 1rem;
			}
			.rentals-criteria ul {
				margin: 0.35rem 0 0.75rem 1.1rem;
				padding: 0;
			}
			.rentals-criteria p {
				margin: 0.35rem 0 0 0;
			}
			.rentals-empty {
				padding: 1.5rem 0;
				color: rgb(var(--gray));
			}
			.rentals-table-wrap {
				overflow-x: auto;
				margin-top: 0.75rem;
			}
			.rentals-table {
				width: 100%;
				border-collapse: collapse;
				font-size: 0.88rem;
				line-height: 1.45;
			}
			.rentals-table th,
			.rentals-table td {
				padding: 0.65rem 0.5rem;
				border-bottom: 1px solid rgba(148, 163, 184, 0.2);
				text-align: left;
				vertical-align: top;
			}
			.rentals-table th {
				font-size: 0.74rem;
				font-weight: 600;
				letter-spacing: 0.04em;
				color: rgb(var(--gray));
				white-space: nowrap;
			}
			.rentals-table tr:hover td {
				background: rgba(148, 163, 184, 0.06);
			}
			.rentals-title {
				font-weight: 600;
				color: rgb(var(--black));
			}
			.rentals-title a {
				color: inherit;
				text-decoration: none;
			}
			.rentals-title a:hover {
				color: var(--accent-dark);
				text-decoration: underline;
			}
			.rentals-sub {
				display: block;
				margin-top: 0.2rem;
				font-size: 0.8rem;
				font-weight: 400;
				color: rgb(var(--gray));
			}
			.rentals-rent {
				font-weight: 700;
				color: rgb(var(--black));
				white-space: nowrap;
			}
			.rentals-fee {
				display: block;
				font-size: 0.78rem;
				font-weight: 400;
				color: rgb(var(--gray));
			}
			.rentals-num {
				font-variant-numeric: tabular-nums;
				white-space: nowrap;
			}
			.rentals-maps {
				display: inline-block;
				margin-top: 0.35rem;
				padding: 0.12rem 0.45rem;
				font-size: 0.72rem;
				font-weight: 600;
				letter-spacing: 0.02em;
				color: var(--accent-dark);
				background: rgba(154, 169, 255, 0.18);
				border-radius: 4px;
				text-decoration: none;
			}
			.rentals-maps:hover {
				text-decoration: underline;
			}
			.rentals-source {
				display: inline-block;
				font-size: 0.72rem;
				font-weight: 600;
				letter-spacing: 0.03em;
				padding: 0.12rem 0.4rem;
				border-radius: 4px;
				background: rgba(154, 169, 255, 0.18);
				color: var(--accent-dark);
				white-space: nowrap;
			}
			.rentals-source--yahoo {
				background: rgba(250, 204, 21, 0.14);
				color: #fde68a;
			}
			.rentals-source--athome {
				background: rgba(125, 211, 252, 0.16);
				color: #7dd3fc;
			}
			.rentals-notes {
				margin-top: 2.5rem;
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}
			.rentals-notes h2 {
				font-size: 0.95rem;
				margin-bottom: 0.4rem;
			}
			.rentals-notes ul {
				margin: 0;
				padding-left: 1.15rem;
			}
			.rentals-howto {
				margin-top: 1.5rem;
				padding-top: 1.25rem;
				border-top: 1px solid rgba(148, 163, 184, 0.2);
				font-size: 0.88rem;
				line-height: 1.65;
				color: rgb(var(--gray-dark));
			}
			.rentals-howto code {
				font-size: 0.86em;
				padding: 0.1em 0.35em;
				border-radius: 4px;
				background: rgba(148, 163, 184, 0.14);
			}
			.rentals-filters {
				display: flex;
				flex-wrap: wrap;
				gap: 0.65rem 0.85rem;
				align-items: end;
				margin: 0 0 1rem 0;
			}
			.rentals-filters label {
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
				font-size: 0.78rem;
				font-weight: 600;
				letter-spacing: 0.04em;
				color: rgb(var(--gray));
			}
			.rentals-filters select,
			.rentals-filters input {
				min-width: 7.5rem;
				padding: 0.4rem 0.55rem;
				border: 1px solid rgba(148, 163, 184, 0.28);
				border-radius: 6px;
				background: rgba(15, 23, 42, 0.85);
				color: rgb(var(--gray-dark));
				font: inherit;
				font-size: 0.9rem;
			}
			.rentals-filters input[type='search'] {
				min-width: 11rem;
			}
			.rentals-filters input[type='number'] {
				min-width: 5.5rem;
				width: 5.5rem;
			}
			.rentals-filters__range {
				display: flex;
				align-items: center;
				gap: 0.35rem;
			}
			.rentals-filters__range span {
				color: rgb(var(--gray));
				font-weight: 400;
			}
			.rentals-count {
				margin: 0 0 0.35rem 0;
				font-size: 0.88rem;
				color: rgb(var(--gray));
			}
			.rentals-table tr[hidden] {
				display: none;
			}
			.rentals-group td {
				background: rgba(148, 163, 184, 0.07);
				border-bottom-color: rgba(148, 163, 184, 0.28);
			}
			.rentals-group:hover td {
				background: rgba(148, 163, 184, 0.12);
			}
			.rentals-toggle {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				margin: 0;
				padding: 0;
				border: 0;
				background: transparent;
				color: inherit;
				font: inherit;
				font-weight: 600;
				text-align: left;
				cursor: pointer;
			}
			.rentals-toggle__chevron {
				display: inline-block;
				width: 0.65em;
				flex: 0 0 auto;
				transition: transform 0.15s ease;
			}
			.rentals-toggle[aria-expanded='true'] .rentals-toggle__chevron {
				transform: rotate(90deg);
			}
			.rentals-toggle__count {
				font-weight: 600;
				color: var(--accent-dark);
				font-size: 0.86em;
			}
			.rentals-group .rentals-source + .rentals-source {
				margin-left: 0.25rem;
			}
			.rentals-fresh-listed td {
				background: rgba(250, 204, 21, 0.16);
			}
			.rentals-fresh-listed:hover td {
				background: rgba(250, 204, 21, 0.24);
			}
			.rentals-fresh-updated td {
				background: rgba(52, 211, 153, 0.14);
			}
			.rentals-fresh-updated:hover td {
				background: rgba(52, 211, 153, 0.22);
			}
			.rentals-fresh-listed.rentals-fresh-updated td {
				background: linear-gradient(
					90deg,
					rgba(250, 204, 21, 0.2) 0%,
					rgba(52, 211, 153, 0.16) 100%
				);
			}
			.rentals-fresh-listed.rentals-fresh-updated:hover td {
				background: linear-gradient(
					90deg,
					rgba(250, 204, 21, 0.28) 0%,
					rgba(52, 211, 153, 0.24) 100%
				);
			}
			.rentals-table th.rentals-sort {
				cursor: pointer;
				user-select: none;
			}
			.rentals-table th.rentals-sort:hover {
				color: rgb(var(--black));
			}
			.rentals-sort__mark {
				font-size: 0.7em;
				margin-left: 0.15em;
				opacity: 0.65;
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="rentals-page">
			<header class="rentals-hero">
				<span class="rentals-hero__tag">個人用メモ</span>
				<h1>通勤圏の賃貸空室</h1>
				<p class="rentals-hero__lead">
					{data.criteria.destination} まで車でおおよそ{
						data.criteria.maxCarMinutes
					}分以内のエリアから、条件に合う掲載をまとめたスナップショットです。ナビには載せていません。
				</p>
				<ul class="rentals-meta">
					<li>最終更新: {updatedLabel}</li>
					<li>件数: <span id="rentals-total">{listings.length}</span></li>
					<li>SUUMO: {bySource.suumo}</li>
					<li>Yahoo!不動産: {bySource.yahoo}</li>
					<li>アットホーム: {bySource.athome}</li>
					<li>黄は掲載が2日以内</li>
					<li>緑は更新が2日以内</li>
				</ul>
			</header>

			<section class="rentals-criteria" aria-labelledby="criteria-heading">
				<h2 id="criteria-heading">検索条件</h2>
				<ul>
					<li>最寄駅まで徒歩 {data.criteria.maxWalkMinutes} 分以内</li>
					<li>
						賃料 {
							data.criteria.maxRentYen != null
								? `${data.criteria.maxRentYen / 10000}万円以下`
								: '指定なし'
						}
					</li>
					<li>間取り: {data.criteria.layouts.join(' / ')}</li>
					<li>{data.criteria.minBuiltYear} 年以降竣工</li>
					<li>駐車場あり / 洗面台独立（Yahoo は「洗面台」条件で近似）</li>
				</ul>
				<p>{data.criteria.commuteAreaNote}</p>
				<p>
					対象市区: {data.criteria.cities.map((c) => c.name).join('、')}
				</p>
			</section>

			{
				listings.length === 0 ? (
					<p class="rentals-empty">
						まだデータがありません。リポジトリで{' '}
						<code>npm run update:rentals</code> を実行し、生成された JSON
						をコミットしてください。
					</p>
				) : (
					<section aria-labelledby="list-heading">
						<h2 id="list-heading">空室一覧</h2>
						<form class="rentals-filters" id="rentals-filters">
							<label>
								市区
								<select name="city" id="filter-city">
									<option value="">すべて</option>
									{data.criteria.cities.map((c) => (
										<option value={c.name}>{c.name}</option>
									))}
								</select>
							</label>
							<label>
								最寄駅
								<select name="station" id="filter-station">
									<option value="">すべて</option>
									{stationOptions.map((name) => (
										<option value={name}>{name}</option>
									))}
								</select>
							</label>
							<label>
								間取り
								<select name="layout" id="filter-layout">
									<option value="">すべて</option>
									{data.criteria.layouts.map((layout) => (
										<option value={layout}>{layout}</option>
									))}
								</select>
							</label>
							<label>
								構造
								<select name="structure-group" id="filter-structure-group">
									<option value="">すべて</option>
									{STRUCTURE_GROUP_OPTIONS.map((name) => (
										<option value={name}>{name}</option>
									))}
								</select>
							</label>
							<label>
								構造（詳細）
								<select name="structure" id="filter-structure">
									<option value="">すべて</option>
									{structureDetailOptions.map((name) => (
										<option value={name}>{name}</option>
									))}
								</select>
							</label>
							<label>
								出典
								<select name="source" id="filter-source">
									<option value="">すべて</option>
									<option value="suumo">SUUMO</option>
									<option value="yahoo">Yahoo</option>
									<option value="athome">アットホーム</option>
								</select>
							</label>
							<label>
								駅徒歩（分以内）
								<select name="walk" id="filter-walk">
									<option value="">指定なし</option>
									<option value="5">5分</option>
									<option value="7">7分</option>
									<option value="10">10分</option>
									<option value="15" selected>
										15分
									</option>
								</select>
							</label>
							<label>
								車通勤（分以内）
								<select name="car" id="filter-car">
									<option value="">指定なし</option>
									<option value="10">10分</option>
									<option value="15">15分</option>
									<option value="20" selected>
										20分
									</option>
									<option value="30">30分</option>
								</select>
							</label>
							<label>
								築年数（年以内）
								<select name="age" id="filter-age">
									<option value="">指定なし</option>
									<option value="5">5年</option>
									<option value="10">10年</option>
									<option value="15">15年</option>
									<option value="20">20年</option>
									<option value="30">30年</option>
									<option value="45">45年（目安:1981〜）</option>
								</select>
							</label>
							<label>
								賃料（万円）
								<span class="rentals-filters__range">
									<input
										type="number"
										id="filter-rent-min"
										min="0"
										step="0.1"
										placeholder="下限"
									/>
									<span>〜</span>
									<input
										type="number"
										id="filter-rent-max"
										min="0"
										step="0.1"
										placeholder="上限"
									/>
								</span>
							</label>
							<label>
								面積（㎡）
								<span class="rentals-filters__range">
									<input
										type="number"
										id="filter-area-min"
										min="0"
										step="1"
										placeholder="下限"
									/>
									<span>〜</span>
									<input
										type="number"
										id="filter-area-max"
										min="0"
										step="1"
										placeholder="上限"
									/>
								</span>
							</label>
							<label>
								キーワード
								<input
									type="search"
									name="q"
									id="filter-q"
									placeholder="駅名・住所など"
									autocomplete="off"
								/>
							</label>
						</form>
						<p class="rentals-count">
							表示 <span id="rentals-shown">{listings.length}</span> 件 /
							<span id="rentals-shown-groups">{listingGroups.length}</span> 物件
							（全 {listings.length} 件 / {listingGroups.length} 物件）
						</p>
						<div class="rentals-table-wrap">
							<table class="rentals-table" id="rentals-table">
								<thead>
									<tr>
										<th class="rentals-sort" data-sort="title" data-type="text">
											物件
											<span class="rentals-sort__mark" aria-hidden="true" />
										</th>
										<th
											class="rentals-sort"
											data-sort="rent"
											data-type="number"
										>
											賃料
											<span class="rentals-sort__mark" aria-hidden="true" />
										</th>
										<th
											class="rentals-sort"
											data-sort="layout"
											data-type="text"
										>
											間取り
											<span class="rentals-sort__mark" aria-hidden="true" />
										</th>
										<th
											class="rentals-sort"
											data-sort="structure"
											data-type="text"
										>
											構造
											<span class="rentals-sort__mark" aria-hidden="true" />
										</th>
										<th
											class="rentals-sort"
											data-sort="walk"
											data-type="number"
										>
											駅徒歩
											<span class="rentals-sort__mark" aria-hidden="true" />
										</th>
										<th class="rentals-sort" data-sort="car" data-type="number">
											車通勤
											<span class="rentals-sort__mark" aria-hidden="true" />
										</th>
										<th class="rentals-sort" data-sort="age" data-type="number">
											築年
											<span class="rentals-sort__mark" aria-hidden="true" />
										</th>
										<th
											class="rentals-sort"
											data-sort="listed"
											data-type="text"
										>
											掲載日
											<span class="rentals-sort__mark" aria-hidden="true" />
										</th>
										<th
											class="rentals-sort"
											data-sort="source"
											data-type="text"
										>
											出典
											<span class="rentals-sort__mark" aria-hidden="true" />
										</th>
									</tr>
								</thead>
								<tbody>
									{listingGroups.map((group) => {
										const first = group.items[0];
										const multi = group.items.length > 1;
										const layouts = uniqueLabels(
											group.items,
											(item) => item.layout,
										);
										const structures = uniqueLabels(
											group.items,
											(item) => item.structure,
										);
										const sources = uniqueLabels(
											group.items,
											(item) => item.source,
										);
										const groupListed = newestDate(group.items, 'listedAt');
										const groupUpdated = newestDate(
											group.items,
											'sourceUpdatedAt',
										);
										const groupFreshListed = group.items.some(isFreshListed);
										const groupFreshUpdated = group.items.some(isFreshUpdated);
										const groupMapsUrl = googleMapsDrivingUrl(first);
										const roomRows = group.items.map((item) => {
											const mapsUrl = googleMapsDrivingUrl(item);
											return (
												<tr
													class:list={[
														multi && 'rentals-room',
														isFreshListed(item) && 'rentals-fresh-listed',
														isFreshUpdated(item) && 'rentals-fresh-updated',
													]}
													data-group={group.id}
													data-city={item.city}
													data-layout={item.layout}
													data-source={item.source}
													data-station={item.stationName || ''}
													data-structure={item.structure || ''}
													data-structure-group={item.structureGroup || ''}
													data-walk={item.walkMinutes ?? ''}
													data-car={item.carMinutes ?? ''}
													data-age={item.ageYears ?? ''}
													data-rent={item.rentYen ?? ''}
													data-area={item.areaSqm ?? ''}
													data-sort-title={item.title}
													data-sort-rent={item.rentYen ?? ''}
													data-sort-layout={item.layout}
													data-sort-structure={item.structure || ''}
													data-sort-walk={item.walkMinutes ?? ''}
													data-sort-car={item.carMinutes ?? ''}
													data-sort-age={item.ageYears ?? ''}
													data-sort-listed={
														item.listedAt || item.sourceUpdatedAt || ''
													}
													data-sort-source={item.source}
													data-text={`${item.title} ${item.address} ${item.station} ${item.layout} ${item.stationName} ${item.structure} ${item.structureGroup}`}
													hidden={multi}
												>
													<td>
														<div class="rentals-title">
															<a
																href={item.url}
																target="_blank"
																rel="noopener noreferrer"
															>
																{multi
																	? item.floorLabel || item.layout
																	: item.title}
															</a>
															<span class="rentals-sub">
																{multi
																	? `${item.layout}${item.areaSqm != null ? ` / ${item.areaSqm}㎡` : ''}`
																	: `${item.address}${item.floorLabel ? ` / ${item.floorLabel}` : ''}${item.areaSqm != null ? ` / ${item.areaSqm}㎡` : ''}`}
															</span>
														</div>
													</td>
													<td>
														<span class="rentals-rent">{item.rentLabel}</span>
														{item.managementFeeLabel && (
															<span class="rentals-fee">
																{item.managementFeeLabel}
															</span>
														)}
													</td>
													<td>{item.layout}</td>
													<td>
														{item.structure || '—'}
														{item.structureGroup &&
															item.structureGroup !== item.structure && (
																<span class="rentals-sub">
																	{item.structureGroup}
																</span>
															)}
													</td>
													<td class="rentals-num">
														{item.walkMinutes != null
															? `${item.walkMinutes}分`
															: '—'}
														{item.stationName && (
															<span class="rentals-sub">
																{item.stationName}
															</span>
														)}
													</td>
													<td class="rentals-num">
														{item.carMinutes != null
															? `約${item.carMinutes}分`
															: '—'}
														<span class="rentals-sub">西浦1-1-1</span>
														{mapsUrl && (
															<a
																class="rentals-maps"
																href={mapsUrl}
																target="_blank"
																rel="noopener noreferrer"
																aria-label={`${item.address}から西浦1-1-1までの車の経路をGoogleマップで開く`}
															>
																Googleで経路
															</a>
														)}
													</td>
													<td>
														{item.buildingAgeLabel}
														{item.builtYear != null && (
															<span class="rentals-sub">
																{item.builtYear}年頃
															</span>
														)}
													</td>
													<td class="rentals-num">
														{item.listedAt || item.sourceUpdatedAt ? (
															<>
																{formatMd(item.listedAt) ||
																	formatMd(item.sourceUpdatedAt)}
																{item.sourceUpdatedAt && (
																	<span class="rentals-sub">
																		更新 {formatMd(item.sourceUpdatedAt)}
																	</span>
																)}
															</>
														) : (
															'—'
														)}
													</td>
													<td>
														<span
															class:list={[
																'rentals-source',
																item.source === 'yahoo' &&
																	'rentals-source--yahoo',
																item.source === 'athome' &&
																	'rentals-source--athome',
															]}
														>
															{sourceLabel(item.source)}
														</span>
													</td>
												</tr>
											);
										});

										if (!multi) return roomRows;

										return (
											<>
												<tr
													class:list={[
														'rentals-group',
														groupFreshListed && 'rentals-fresh-listed',
														groupFreshUpdated && 'rentals-fresh-updated',
													]}
													data-group={group.id}
													data-sort-title={group.title}
													data-sort-rent={Math.min(
														...group.items.map(
															(item) => item.rentYen ?? 9999999,
														),
													)}
													data-sort-layout={layouts[0] || ''}
													data-sort-structure={structures[0] || ''}
													data-sort-walk={first.walkMinutes ?? ''}
													data-sort-car={first.carMinutes ?? ''}
													data-sort-age={first.ageYears ?? ''}
													data-sort-listed={groupListed || groupUpdated || ''}
													data-sort-source={sources[0] || ''}
												>
													<td>
														<button
															type="button"
															class="rentals-toggle"
															aria-expanded="false"
															data-group={group.id}
														>
															<span
																class="rentals-toggle__chevron"
																aria-hidden="true"
															>
																▶
															</span>
															<span>{group.title}</span>
															<span class="rentals-toggle__count">
																（
																<span data-group-count>
																	{group.items.length}
																</span>
																件）
															</span>
														</button>
														<span class="rentals-sub">{group.address}</span>
													</td>
													<td>
														<span class="rentals-rent">
															{rentRangeLabel(group.items)}
														</span>
													</td>
													<td>{layouts.join(' / ')}</td>
													<td>{structures.join(' / ') || '—'}</td>
													<td class="rentals-num">
														{first.walkMinutes != null
															? `${first.walkMinutes}分`
															: '—'}
														{first.stationName && (
															<span class="rentals-sub">
																{first.stationName}
															</span>
														)}
													</td>
													<td class="rentals-num">
														{first.carMinutes != null
															? `約${first.carMinutes}分`
															: '—'}
														<span class="rentals-sub">西浦1-1-1</span>
														{groupMapsUrl && (
															<a
																class="rentals-maps"
																href={groupMapsUrl}
																target="_blank"
																rel="noopener noreferrer"
																aria-label={`${group.address}から西浦1-1-1までの車の経路をGoogleマップで開く`}
															>
																Googleで経路
															</a>
														)}
													</td>
													<td>
														{first.buildingAgeLabel}
														{first.builtYear != null && (
															<span class="rentals-sub">
																{first.builtYear}年頃
															</span>
														)}
													</td>
													<td class="rentals-num">
														{groupListed || groupUpdated ? (
															<>
																{formatMd(groupListed) ||
																	formatMd(groupUpdated)}
																{groupUpdated && (
																	<span class="rentals-sub">
																		更新 {formatMd(groupUpdated)}
																	</span>
																)}
															</>
														) : (
															'—'
														)}
													</td>
													<td>
														{sources.map((source) => (
															<span
																class:list={[
																	'rentals-source',
																	source === 'yahoo' && 'rentals-source--yahoo',
																	source === 'athome' &&
																		'rentals-source--athome',
																]}
															>
																{sourceLabel(source)}
															</span>
														))}
													</td>
												</tr>
												{roomRows}
											</>
										);
									})}
								</tbody>
							</table>
						</div>
					</section>
				)
			}

			<section class="rentals-howto" aria-labelledby="howto-heading">
				<h2 id="howto-heading">この一覧について</h2>
				<p>
					毎日 9時・14時・20時（日本時間）に GitHub Actions
					が自動で取り直します。掲載2日以内は黄色、情報更新2日以内は緑で示します。
				</p>
				<p>列見出しをクリックすると並び替えできます。</p>
				<p>
					車通勤の分数は OSRM
					の概算です。Googleで経路を押すと、その物件から西浦1-1-1までの車ルートが
					Google マップで開きます。
				</p>
				<p>
					SUUMO の構造は鉄筋系 / 鉄骨系 / 木造 /
					その他の系統のみです。鉄筋コンクリートや軽量鉄骨などの詳細は Yahoo
					側で絞れます。アットホームは駐車場（近隣含む）と洗面所独立で近似しています。
				</p>
			</section>

			{
				data.notes?.length > 0 && (
					<section class="rentals-notes" aria-labelledby="notes-heading">
						<h2 id="notes-heading">注意</h2>
						<ul>
							{data.notes.map((note) => (
								<li>{note}</li>
							))}
						</ul>
					</section>
				)
			}
		</main>
		<script is:inline>
			(function () {
				var form = document.getElementById('rentals-filters');
				var table = document.getElementById('rentals-table');
				var shown = document.getElementById('rentals-shown');
				var shownGroups = document.getElementById('rentals-shown-groups');
				if (!form || !table) return;

				function num(id) {
					var el = document.getElementById(id);
					if (!el || el.value === '') return null;
					var n = Number(el.value);
					return Number.isFinite(n) ? n : null;
				}

				function attrNum(row, name) {
					var raw = row.getAttribute(name);
					if (raw === null || raw === '') return null;
					var n = Number(raw);
					return Number.isFinite(n) ? n : null;
				}

				function isGroupRow(row) {
					return row.classList.contains('rentals-group');
				}

				function isExpanded(groupId) {
					var btn = table.querySelector(
						'.rentals-toggle[data-group="' + groupId + '"]',
					);
					return !!(btn && btn.getAttribute('aria-expanded') === 'true');
				}

				function apply() {
					var city = document.getElementById('filter-city').value;
					var station = document.getElementById('filter-station').value;
					var layout = document.getElementById('filter-layout').value;
					var source = document.getElementById('filter-source').value;
					var structureGroup = document.getElementById(
						'filter-structure-group',
					).value;
					var structure = document.getElementById('filter-structure').value;
					var walkMax = num('filter-walk');
					var carMax = num('filter-car');
					var ageMax = num('filter-age');
					var rentMin = num('filter-rent-min');
					var rentMax = num('filter-rent-max');
					var areaMin = num('filter-area-min');
					var areaMax = num('filter-area-max');
					var q = (document.getElementById('filter-q').value || '')
						.trim()
						.toLowerCase();
					var rows = table.tBodies[0].rows;
					var matchByGroup = {};
					var roomCount = 0;

					for (var i = 0; i < rows.length; i++) {
						var row = rows[i];
						if (isGroupRow(row)) continue;
						var walk = attrNum(row, 'data-walk');
						var car = attrNum(row, 'data-car');
						var age = attrNum(row, 'data-age');
						var rent = attrNum(row, 'data-rent');
						var area = attrNum(row, 'data-area');
						var ok =
							(!city || row.getAttribute('data-city') === city) &&
							(!station || row.getAttribute('data-station') === station) &&
							(!layout || row.getAttribute('data-layout') === layout) &&
							(!source || row.getAttribute('data-source') === source) &&
							(!structureGroup ||
								row.getAttribute('data-structure-group') === structureGroup) &&
							(!structure ||
								row.getAttribute('data-structure') === structure) &&
							(walkMax == null || (walk != null && walk <= walkMax)) &&
							(carMax == null || (car != null && car <= carMax)) &&
							(ageMax == null || (age != null && age <= ageMax)) &&
							(rentMin == null || (rent != null && rent >= rentMin * 10000)) &&
							(rentMax == null || (rent != null && rent <= rentMax * 10000)) &&
							(areaMin == null || (area != null && area >= areaMin)) &&
							(areaMax == null || (area != null && area <= areaMax)) &&
							(!q ||
								(row.getAttribute('data-text') || '')
									.toLowerCase()
									.indexOf(q) !== -1);
						row.setAttribute('data-match', ok ? '1' : '0');
						var groupId = row.getAttribute('data-group') || '';
						if (!matchByGroup[groupId]) matchByGroup[groupId] = 0;
						if (ok) {
							matchByGroup[groupId] += 1;
							roomCount += 1;
						}
						var multi = row.classList.contains('rentals-room');
						if (multi) {
							row.hidden = !ok || !isExpanded(groupId);
						} else {
							row.hidden = !ok;
						}
					}

					var groupCount = 0;
					for (var j = 0; j < rows.length; j++) {
						var header = rows[j];
						if (!isGroupRow(header)) continue;
						var gid = header.getAttribute('data-group') || '';
						var n = matchByGroup[gid] || 0;
						var countEl = header.querySelector('[data-group-count]');
						if (countEl) countEl.textContent = String(n);
						header.hidden = n === 0;
					}
					for (var key in matchByGroup) {
						if (
							Object.prototype.hasOwnProperty.call(matchByGroup, key) &&
							matchByGroup[key] > 0
						) {
							groupCount += 1;
						}
					}

					if (shown) shown.textContent = String(roomCount);
					if (shownGroups) shownGroups.textContent = String(groupCount);
				}

				table.addEventListener('click', function (event) {
					var t = event.target;
					if (t && t.nodeType === 3) t = t.parentElement;
					var btn = t && t.closest ? t.closest('.rentals-toggle') : null;
					if (!btn || !table.contains(btn)) return;
					var groupId = btn.getAttribute('data-group');
					var open = btn.getAttribute('aria-expanded') !== 'true';
					btn.setAttribute('aria-expanded', open ? 'true' : 'false');
					var rooms = table.querySelectorAll(
						'tr.rentals-room[data-group="' + groupId + '"]',
					);
					for (var i = 0; i < rooms.length; i++) {
						var room = rooms[i];
						var match = room.getAttribute('data-match') !== '0';
						room.hidden = !open || !match;
					}
				});

				function sortChunks(key, type, dir) {
					var tbody = table.tBodies[0];
					var rows = Array.prototype.slice.call(tbody.rows);
					var chunks = [];
					for (var i = 0; i < rows.length; ) {
						var row = rows[i];
						if (row.classList.contains('rentals-group')) {
							var gid = row.getAttribute('data-group');
							var nodes = [row];
							i += 1;
							while (
								i < rows.length &&
								rows[i].classList.contains('rentals-room') &&
								rows[i].getAttribute('data-group') === gid
							) {
								nodes.push(rows[i]);
								i += 1;
							}
							chunks.push({ head: row, nodes: nodes });
						} else {
							chunks.push({ head: row, nodes: [row] });
							i += 1;
						}
					}
					chunks.sort(function (a, b) {
						var av = a.head.getAttribute('data-sort-' + key) || '';
						var bv = b.head.getAttribute('data-sort-' + key) || '';
						if (key === 'listed') {
							if (!av && !bv) return 0;
							if (!av) return 1;
							if (!bv) return -1;
						}
						var cmp = 0;
						if (type === 'number') {
							var an = av === '' ? Number.POSITIVE_INFINITY : Number(av);
							var bn = bv === '' ? Number.POSITIVE_INFINITY : Number(bv);
							if (!Number.isFinite(an)) an = Number.POSITIVE_INFINITY;
							if (!Number.isFinite(bn)) bn = Number.POSITIVE_INFINITY;
							cmp = an - bn;
						} else {
							cmp = av.localeCompare(bv, 'ja');
						}
						return dir === 'desc' ? -cmp : cmp;
					});
					chunks.forEach(function (chunk) {
						chunk.nodes.forEach(function (node) {
							tbody.appendChild(node);
						});
					});
				}

				table.querySelectorAll('th.rentals-sort').forEach(function (th) {
					th.addEventListener('click', function () {
						var key = th.getAttribute('data-sort');
						var type = th.getAttribute('data-type') || 'text';
						var current = table.getAttribute('data-sort-key');
						var dir = table.getAttribute('data-sort-dir') || 'asc';
						if (current === key) dir = dir === 'asc' ? 'desc' : 'asc';
						else dir = key === 'listed' ? 'desc' : 'asc';
						table.setAttribute('data-sort-key', key);
						table.setAttribute('data-sort-dir', dir);
						table.querySelectorAll('th.rentals-sort').forEach(function (other) {
							other.setAttribute('aria-sort', 'none');
							var mark = other.querySelector('.rentals-sort__mark');
							if (mark) mark.textContent = '';
						});
						th.setAttribute(
							'aria-sort',
							dir === 'asc' ? 'ascending' : 'descending',
						);
						var mark = th.querySelector('.rentals-sort__mark');
						if (mark) mark.textContent = dir === 'asc' ? '▲' : '▼';
						sortChunks(key, type, dir);
					});
				});

				form.addEventListener('input', apply);
				form.addEventListener('change', apply);
				apply();
			})();
		</script>
		<Footer />
	</body>
</html>
