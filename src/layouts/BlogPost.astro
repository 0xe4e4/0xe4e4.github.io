---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import SiteShell from '../components/SiteShell.astro';
import { sortBlogPostsNewestFirst } from '../utils/sortBlogPosts';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: MarkdownHeading[];
};

const {
	title,
	description,
	date,
	updatedDate,
	heroImage,
	headings = [],
} = Astro.props;
const posts = sortBlogPostsNewestFirst(await getCollection('blog'));
const modifiedTime =
	updatedDate && updatedDate.valueOf() > date.valueOf()
		? updatedDate
		: undefined;

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
const hasToc = tocHeadings.length > 0;
---

<SiteShell
	title={title}
	description={description}
	image={heroImage}
	posts={posts}
	ogType="article"
	publishedTime={date}
	modifiedTime={modifiedTime}
>
	<style is:global slot="head">
		.blog-article {
			width: 100%;
		}
		.blog-article--has-toc {
			display: block;
		}
		@media (min-width: 900px) {
			.blog-article--has-toc {
				display: grid;
				grid-template-columns: minmax(11rem, 13.5rem) minmax(0, 1fr);
				gap: 1.5rem 2rem;
				align-items: start;
			}
		}
		.article-toc {
			display: none;
		}
		@media (min-width: 900px) {
			.blog-article--has-toc .article-toc {
				display: block;
				position: sticky;
				top: 5rem;
				max-height: calc(100vh - 6rem);
				overflow-y: auto;
				padding: 0.35rem 0.5rem 0.75rem 0;
				font-size: 0.86rem;
				line-height: 1.45;
				border-right: 1px solid rgba(148, 163, 184, 0.2);
			}
		}
		.article-toc__title {
			margin: 0 0 0.5rem 0;
			font-size: 0.72rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: rgb(var(--gray));
		}
		.article-toc ul {
			list-style: none;
			margin: 0;
			padding: 0;
		}
		.article-toc li {
			margin: 0 0 0.4rem 0;
		}
		.article-toc a {
			color: rgb(var(--gray-dark));
			text-decoration: none;
			display: block;
			border-radius: 4px;
			padding: 0.1rem 0.2rem;
		}
		.article-toc a:hover {
			color: var(--accent);
		}
		.article-toc__depth-3 {
			padding-left: 0.65rem;
		}
		.article-toc__depth-4 {
			padding-left: 1.2rem;
		}
		.blog-article__main {
			min-width: 0;
		}
		.blog-article .hero-image {
			width: 100%;
			max-width: 68ch;
			margin: 0 auto;
		}
		.blog-article .hero-image img {
			display: block;
			margin: 0 auto;
			border-radius: 8px;
			box-shadow: var(--box-shadow);
		}
		.blog-article .prose {
			width: min(68ch, 100%);
			margin: 0 auto;
			padding: 1.25em 0 2em;
			color: rgb(var(--gray-dark));
		}
		.blog-article .title {
			margin-bottom: 1.75em;
			padding: 0.5em 0 1em;
			text-align: left;
			line-height: 1.35;
		}
		.blog-article .title h1 {
			margin: 0.35em 0 0 0;
			font-size: clamp(1.65rem, 4vw, 2.15rem);
			font-weight: 700;
			letter-spacing: -0.02em;
		}
		.blog-article .date {
			margin: 0;
			color: rgb(var(--gray));
			font-size: 0.95rem;
		}
		.blog-article .last-updated-on {
			font-style: italic;
			margin-top: 0.35em;
			font-size: 0.9rem;
		}
		.blog-article .prose :global(h2) {
			margin-top: 2em;
		}
		.blog-article .prose :global(h3) {
			margin-top: 1.5em;
		}
		.blog-article .prose :global(pre) {
			font-size: 0.88em;
			line-height: 1.55;
		}
		.blog-article .prose :global(li) {
			margin-bottom: 0.35em;
		}
	</style>
	<article class:list={['blog-article', hasToc && 'blog-article--has-toc']}>
		{
			hasToc && (
				<nav class="article-toc" aria-label="目次">
					<h2 class="article-toc__title">目次</h2>
					<ul>
						{tocHeadings.map((h) => (
							<li class:list={[`article-toc__depth-${h.depth}`]}>
								<a href={`#${h.slug}`}>{h.text}</a>
							</li>
						))}
					</ul>
				</nav>
			)
		}
		<div class="blog-article__main">
			{
				heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)
			}
			<div class="prose">
				<header class="title">
					<div class="date">
						<FormattedDate date={date} />
						{
							updatedDate && (
								<div class="last-updated-on">
									更新: <FormattedDate date={updatedDate} />
								</div>
							)
						}
					</div>
					<h1>{title}</h1>
					<hr />
				</header>
				<slot />
			</div>
		</div>
	</article>
</SiteShell>
