---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import SiteShell from '../components/SiteShell.astro';
import { sortBlogPostsNewestFirst } from '../utils/sortBlogPosts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, date, updatedDate, heroImage } = Astro.props;
const posts = sortBlogPostsNewestFirst(await getCollection('blog'));
const modifiedTime =
	updatedDate && updatedDate.valueOf() > date.valueOf()
		? updatedDate
		: undefined;
---

<SiteShell
	title={title}
	description={description}
	image={heroImage}
	posts={posts}
	ogType="article"
	publishedTime={date}
	modifiedTime={modifiedTime}
>
	<style is:global slot="head">
		.blog-article .hero-image {
			width: 100%;
			max-width: 68ch;
			margin: 0 auto;
		}
		.blog-article .hero-image img {
			display: block;
			margin: 0 auto;
			border-radius: 8px;
			box-shadow: var(--box-shadow);
		}
		.blog-article .prose {
			width: min(68ch, 100%);
			margin: 0 auto;
			padding: 1.25em 0 2em;
			color: rgb(var(--gray-dark));
		}
		.blog-article .title {
			margin-bottom: 1.75em;
			padding: 0.5em 0 1em;
			text-align: left;
			line-height: 1.35;
		}
		.blog-article .title h1 {
			margin: 0.35em 0 0 0;
			font-size: clamp(1.65rem, 4vw, 2.15rem);
			font-weight: 700;
			letter-spacing: -0.02em;
		}
		.blog-article .date {
			margin: 0;
			color: rgb(var(--gray));
			font-size: 0.95rem;
		}
		.blog-article .last-updated-on {
			font-style: italic;
			margin-top: 0.35em;
			font-size: 0.9rem;
		}
		.blog-article .prose :global(h2) {
			margin-top: 2em;
		}
		.blog-article .prose :global(h3) {
			margin-top: 1.5em;
		}
		.blog-article .prose :global(pre) {
			font-size: 0.88em;
			line-height: 1.55;
		}
		.blog-article .prose :global(li) {
			margin-bottom: 0.35em;
		}
	</style>
	<article class="blog-article">
		{
			heroImage && (
				<div class="hero-image">
					<Image width={1020} height={510} src={heroImage} alt="" />
				</div>
			)
		}
		<div class="prose">
			<header class="title">
				<div class="date">
					<FormattedDate date={date} />
					{
						updatedDate && (
							<div class="last-updated-on">
								更新: <FormattedDate date={updatedDate} />
							</div>
						)
					}
				</div>
				<h1>{title}</h1>
				<hr />
			</header>
			<slot />
		</div>
	</article>
</SiteShell>
